<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Product>Coraza</Product>
    <Company>Coraza</Company>
    <Authors>Coraza</Authors>
    <Copyright>Coraza · 2026</Copyright>
    <!-- Debe coincidir con la etiqueta de la Release publicada (v1.0) y con
         instalador.iss. Si el programa se identifica con una versión menor que la
         publicada, el comprobador de actualizaciones avisaría siempre. -->
    <Version>1.1.0</Version>
    <NeutralLanguage>es</NeutralLanguage>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
