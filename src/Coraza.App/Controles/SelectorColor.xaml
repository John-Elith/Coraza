<UserControl x:Class="Coraza.App.Controles.SelectorColor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="Muestra" Width="32" Height="30" Padding="2" Background="Transparent" BorderThickness="0" Click="Muestra_Click" ToolTip="Elegir un color">
            <Border Width="24" Height="24" CornerRadius="5" BorderBrush="{DynamicResource B.Borde}" BorderThickness="1"
                    Background="{Binding Color, ElementName=Raiz, Converter={StaticResource HexPincel}}" />
        </Button>
        <TextBox Grid.Column="1" Margin="6,0,0,0" FontFamily="Consolas" Text="{Binding Color, ElementName=Raiz, UpdateSourceTrigger=LostFocus}" />
        <Popup x:Name="Ventana" PlacementTarget="{Binding ElementName=Muestra}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource B.PanelAlto}" BorderBrush="{DynamicResource B.Borde}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,0,0">
                <ItemsControl x:Name="Paleta">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="24" Height="24" Margin="2" Padding="0" Tag="{Binding}" ToolTip="{Binding}" Click="Color_Click"
                                    Background="{Binding Converter={StaticResource HexPincel}}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
