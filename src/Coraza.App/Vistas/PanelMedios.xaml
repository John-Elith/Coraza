<UserControl x:Class="Coraza.App.Vistas.PanelMedios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coraza.App.Controles"
             xmlns:vm="clr-namespace:Coraza.App.ViewModels"
             Foreground="{DynamicResource B.Texto}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Style="{StaticResource Boton.Primario}" Command="{Binding AgregarArchivosCommand}" Padding="8,5" ToolTip="Agregar imágenes desde el equipo">
                <StackPanel Orientation="Horizontal">
                    <c:Icono Datos="{StaticResource Ico.Mas}" Width="13" Height="13" />
                    <TextBlock Text="Agregar" Margin="4,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Boton.Icono}" Command="{Binding AgregarCarpetaCommand}" Margin="4,0,0,0" ToolTip="Importar una carpeta completa (por ejemplo de una memoria USB)">
                <c:Icono Datos="{StaticResource Ico.Carpeta}" />
            </Button>
            <Button x:Name="BotonPegarMedio" Style="{StaticResource Boton.Icono}" Command="{Binding PegarCommand}" ToolTip="Pegar imágenes o archivos del portapapeles (Ctrl + V)">
                <c:Icono Datos="{StaticResource Ico.Pegar}" />
            </Button>
            <Button x:Name="BotonPresentacion" Style="{StaticResource Boton.Icono}" Command="{Binding CrearPresentacionCommand}"
                    ToolTip="Presentación de fotos: una carpeta completa que avanza sola y se repite">
                <c:Icono Datos="{StaticResource Ico.Rejilla}" />
            </Button>
            <Button x:Name="BotonPowerPoint" Style="{StaticResource Boton.Icono}" Command="{Binding AgregarPresentacionCommand}"
                    ToolTip="Proyectar PowerPoint o PDF: cada diapositiva o página se convierte en una imagen">
                <c:Icono Datos="{StaticResource Ico.Documento}" />
            </Button>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock Text="Ajuste" Style="{StaticResource T.Suave}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Ajustes}" SelectedItem="{Binding AjusteSeleccionado}" DisplayMemberPath="Nombre"
                      ToolTip="Cómo se acomoda la imagen elegida en la pantalla" />
        </DockPanel>
        <Grid>
            <ListBox x:Name="Lista" ItemsSource="{Binding Medios}" SelectedItem="{Binding Seleccionado}" AllowDrop="True"
                     ItemContainerStyle="{StaticResource Item.Tarjeta}" DragOver="Lista_DragOver" Drop="Lista_Drop" MouseDoubleClick="Lista_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MedioViewModel}">
                        <StackPanel Width="118" ToolTip="{Binding Nombre}">
                            <Border Height="66" Background="Black" CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Miniatura}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <c:Icono Datos="{StaticResource Ico.Musica}" Width="26" Height="26" Foreground="{DynamicResource B.Coral}"
                                             Visibility="{Binding EsAudio, Converter={StaticResource BoolVis}}" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" Background="#CC000000" CornerRadius="3" Padding="4,0"
                                            Visibility="{Binding Insignia, Converter={StaticResource VacioVis}}">
                                        <TextBlock Text="{Binding Insignia}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Nombre}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,4,2,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Agregar al servicio" Command="{Binding AgregarAlServicioCommand}" />
                        <MenuItem Header="Reproducir como música de fondo" Command="{Binding ReproducirMusicaCommand}" />
                        <Separator />
                        <MenuItem Header="Eliminar de la biblioteca" Command="{Binding EliminarCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <StackPanel VerticalAlignment="Center" Margin="12" IsHitTestVisible="False" Visibility="{Binding SinMedios, Converter={StaticResource BoolVis}}">
                <c:Icono Datos="{StaticResource Ico.Imagen}" Width="40" Height="40" Foreground="{DynamicResource B.Borde}" />
                <TextBlock Text="Arrastra archivos aquí" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock Text="Imágenes, videos MP4, música MP3, PDF y PowerPoint. También puedes usar «Agregar», importar una carpeta de una USB o pegar con Ctrl + V. Todo se copia a la biblioteca de Coraza."
                           TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource T.Suave}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
