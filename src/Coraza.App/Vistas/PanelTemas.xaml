<UserControl x:Class="Coraza.App.Vistas.PanelTemas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coraza.App.Controles"
             xmlns:vm="clr-namespace:Coraza.App.ViewModels"
             xmlns:r="clr-namespace:Coraza.Rendering;assembly=Coraza.Rendering"
             Foreground="{DynamicResource B.Texto}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BotonNuevoTema" Style="{StaticResource Boton.Primario}" Command="{Binding NuevoCommand}" Padding="8,5" ToolTip="Nuevo tema a partir del elegido">
                <StackPanel Orientation="Horizontal">
                    <c:Icono Datos="{StaticResource Ico.Mas}" Width="13" Height="13" />
                    <TextBlock Text="Nuevo" Margin="4,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Boton.Icono}" Command="{Binding EditarCommand}" Margin="4,0,0,0" ToolTip="Editar tema">
                <c:Icono Datos="{StaticResource Ico.Editar}" />
            </Button>
            <Button Style="{StaticResource Boton.Icono}" Command="{Binding DuplicarCommand}" ToolTip="Duplicar tema">
                <c:Icono Datos="{StaticResource Ico.Copiar}" />
            </Button>
            <Button Style="{StaticResource Boton.Icono}" Command="{Binding EliminarCommand}" ToolTip="Eliminar tema">
                <c:Icono Datos="{StaticResource Ico.Papelera}" />
            </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="USAR EL TEMA ELEGIDO PARA" Style="{StaticResource T.Seccion}" Margin="2,0,0,6" />
            <UniformGrid Columns="2">
                <Button Content="Canciones" Command="{Binding UsarParaCommand}" CommandParameter="Canciones" Margin="0,0,3,4" />
                <Button Content="Biblia" Command="{Binding UsarParaCommand}" CommandParameter="Biblia" Margin="3,0,0,4" />
                <Button Content="Textos" Command="{Binding UsarParaCommand}" CommandParameter="Textos" Margin="0,0,3,0" />
                <Button Content="Imágenes" Command="{Binding UsarParaCommand}" CommandParameter="Imagenes" Margin="3,0,0,0" />
            </UniformGrid>
        </StackPanel>
        <ListBox ItemsSource="{Binding Temas}" SelectedItem="{Binding Seleccionado}" ItemContainerStyle="{StaticResource Item.Tarjeta}"
                 HorizontalContentAlignment="Stretch" MouseDoubleClick="Lista_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TemaItem}">
                    <StackPanel>
                        <Border CornerRadius="4" ClipToBounds="True" Background="Black">
                            <Viewbox Stretch="Uniform">
                                <r:LienzoDiapositiva Width="1920" Height="1080" Miniatura="True" Tema="{Binding Tema}"
                                                     Diapositiva="{x:Static vm:PanelTemasViewModel.MuestraCancion}" />
                            </Viewbox>
                        </Border>
                        <DockPanel Margin="2,5,2,1">
                            <TextBlock DockPanel.Dock="Right" Text="incluido" Style="{StaticResource T.Suave}" FontSize="11"
                                       Visibility="{Binding Predefinido, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Usos}" Foreground="{DynamicResource B.Coral}" FontSize="11" Margin="2,0,2,2"
                                   Visibility="{Binding Usos, Converter={StaticResource VacioVis}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
