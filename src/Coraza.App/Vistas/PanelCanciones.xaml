<UserControl x:Class="Coraza.App.Vistas.PanelCanciones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coraza.App.Controles"
             xmlns:m="clr-namespace:Coraza.Core.Modelos;assembly=Coraza.Core"
             Foreground="{DynamicResource B.Texto}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBox x:Name="Caja" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" Tag="Buscar por título o letra…" Padding="30,6,8,6" />
            <c:Icono Datos="{StaticResource Ico.Buscar}" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left"
                     Foreground="{DynamicResource B.TextoSuave}" IsHitTestVisible="False" />
        </Grid>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Filtros}" SelectedItem="{Binding Filtro}" ToolTip="Filtrar la biblioteca" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                <Button x:Name="BotonNuevaCancion" Style="{StaticResource Boton.Primario}" Command="{Binding NuevaCommand}" Padding="8,5" ToolTip="Nueva canción (Ctrl + N)">
                    <StackPanel Orientation="Horizontal">
                        <c:Icono Datos="{StaticResource Ico.Mas}" Width="13" Height="13" />
                        <TextBlock Text="Nueva" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Boton.Icono}" Command="{Binding PegarLetraCommand}" ToolTip="Pegar una letra copiada de una página web">
                    <c:Icono Datos="{StaticResource Ico.Pegar}" />
                </Button>
                <Button Style="{StaticResource Boton.Icono}" Command="{Binding ImportarCommand}" ToolTip="Importar archivos TXT, ChordPro o SongSelect">
                    <c:Icono Datos="{StaticResource Ico.Importar}" />
                </Button>
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Resumen}" Style="{StaticResource T.Suave}" Margin="2,6,0,0" />
        <Grid>
            <ListBox x:Name="Lista" ItemsSource="{Binding Canciones}" SelectedItem="{Binding Seleccionada}"
                     VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="Lista_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Cancion}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PrimeraLinea}" Style="{StaticResource T.Suave}" FontSize="11.5" />
                            </StackPanel>
                            <c:Icono Grid.Column="1" Datos="{StaticResource Ico.Estrella}" Relleno="True" Width="12" Height="12" Margin="6,0,0,0"
                                     Foreground="{DynamicResource B.Coral}" Visibility="{Binding Favorita, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Agregar al servicio" Command="{Binding AgregarAlServicioCommand}"
                                  Visibility="{Binding EnPapelera, Converter={StaticResource BoolVis}, ConverterParameter=invertir}" />
                        <MenuItem Header="Editar…" Command="{Binding EditarCommand}"
                                  Visibility="{Binding EnPapelera, Converter={StaticResource BoolVis}, ConverterParameter=invertir}" />
                        <MenuItem Header="Duplicar" Command="{Binding DuplicarCommand}"
                                  Visibility="{Binding EnPapelera, Converter={StaticResource BoolVis}, ConverterParameter=invertir}" />
                        <MenuItem Header="Marcar o quitar favorita" Command="{Binding AlternarFavoritaCommand}"
                                  Visibility="{Binding EnPapelera, Converter={StaticResource BoolVis}, ConverterParameter=invertir}" />
                        <MenuItem Header="Mover a la papelera" Command="{Binding EliminarCommand}"
                                  Visibility="{Binding EnPapelera, Converter={StaticResource BoolVis}, ConverterParameter=invertir}" />
                        <MenuItem Header="Restaurar" Command="{Binding RestaurarCommand}"
                                  Visibility="{Binding EnPapelera, Converter={StaticResource BoolVis}}" />
                        <MenuItem Header="Eliminar para siempre" Command="{Binding EliminarDefinitivamenteCommand}"
                                  Visibility="{Binding EnPapelera, Converter={StaticResource BoolVis}}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <StackPanel VerticalAlignment="Center" Margin="12" Visibility="{Binding BibliotecaVacia, Converter={StaticResource BoolVis}}">
                <c:Icono Datos="{StaticResource Ico.Musica}" Width="40" Height="40" Foreground="{DynamicResource B.Borde}" />
                <TextBlock Text="Aún no tienes canciones" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock Text="Crea la primera, pega una letra copiada de internet o importa tus archivos."
                           TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource T.Suave}" />
                <Button Content="Crear mi primera canción" Style="{StaticResource Boton.Primario}" Command="{Binding NuevaCommand}"
                        HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
