<UserControl x:Class="Coraza.App.Vistas.PanelTextos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coraza.App.Controles"
             xmlns:m="clr-namespace:Coraza.Core.Modelos;assembly=Coraza.Core"
             Foreground="{DynamicResource B.Texto}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BotonNuevoTexto" Style="{StaticResource Boton.Primario}" Command="{Binding NuevoCommand}" Padding="8,5" ToolTip="Nuevo texto, anuncio o aviso">
                <StackPanel Orientation="Horizontal">
                    <c:Icono Datos="{StaticResource Ico.Mas}" Width="13" Height="13" />
                    <TextBlock Text="Nuevo" Margin="4,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Boton.Icono}" Command="{Binding EditarCommand}" Margin="4,0,0,0" ToolTip="Editar">
                <c:Icono Datos="{StaticResource Ico.Editar}" />
            </Button>
            <Button Style="{StaticResource Boton.Icono}" Command="{Binding EliminarCommand}" ToolTip="Eliminar">
                <c:Icono Datos="{StaticResource Ico.Papelera}" />
            </Button>
        </StackPanel>
        <Grid>
            <ListBox x:Name="Lista" ItemsSource="{Binding Textos}" SelectedItem="{Binding Seleccionado}" MouseDoubleClick="Lista_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:TextoLibre}">
                        <StackPanel>
                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Contenido}" Style="{StaticResource T.Suave}" FontSize="11.5" MaxHeight="16" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Agregar al servicio" Command="{Binding AgregarAlServicioCommand}" />
                        <MenuItem Header="Editar…" Command="{Binding EditarCommand}" />
                        <MenuItem Header="Mostrar como marquesina" Command="{Binding ComoMarquesinaCommand}" />
                        <Separator />
                        <MenuItem Header="Eliminar" Command="{Binding EliminarCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <StackPanel VerticalAlignment="Center" Margin="12" Visibility="{Binding SinTextos, Converter={StaticResource BoolVis}}">
                <c:Icono Datos="{StaticResource Ico.Texto}" Width="40" Height="40" Foreground="{DynamicResource B.Borde}" />
                <TextBlock Text="Sin textos ni anuncios" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock Text="Crea bienvenidas, avisos de ofrenda, eventos o cumpleaños. Hay plantillas listas para empezar."
                           TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource T.Suave}" />
                <Button Content="Crear un anuncio" Style="{StaticResource Boton.Primario}" Command="{Binding NuevoCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
