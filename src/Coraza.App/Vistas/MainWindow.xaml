<Window x:Class="Coraza.App.Vistas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Coraza.App.Controles"
        xmlns:v="clr-namespace:Coraza.App.Vistas"
        xmlns:vm="clr-namespace:Coraza.App.ViewModels"
        xmlns:r="clr-namespace:Coraza.Rendering;assembly=Coraza.Rendering"
        Title="Coraza" Width="1366" Height="768" MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource B.Fondo}" Foreground="{DynamicResource B.Texto}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Icon="/Recursos/coraza.ico" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="EstiloProyectar" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Proyeccion.Proyectando}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.Teja}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EstiloPatron" TargetType="Button" BasedOn="{StaticResource Boton.Fantasma}">
            <Setter Property="Padding" Value="8,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Proyeccion.PatronPrueba}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.Coral}" />
                    <Setter Property="Foreground" Value="{DynamicResource B.SobreAcento}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EstiloMarquesina" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Padding" Value="6,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Proyeccion.HayMarquesina}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.Coral}" />
                    <Setter Property="Foreground" Value="{DynamicResource B.SobreAcento}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EstiloReloj" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Padding" Value="6,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Proyeccion.RelojVisible}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.Coral}" />
                    <Setter Property="Foreground" Value="{DynamicResource B.SobreAcento}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanicoBarra" TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Panico}">
            <Setter Property="Foreground" Value="{DynamicResource B.Lino}" />
            <Setter Property="BorderBrush" Value="#55FC8F8F" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Raiz">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ================= Barra superior ================= -->
        <Border Grid.Row="0" Background="{DynamicResource B.Barra}">
            <!-- La barra es oscura en todas las paletas: sus controles (y la lista de pantallas) usan siempre tonos oscuros. -->
            <Border.Resources>
                <SolidColorBrush x:Key="B.Texto" Color="#EDE6E5" />
                <SolidColorBrush x:Key="B.TextoSuave" Color="#CDBFC0" />
                <SolidColorBrush x:Key="B.Entrada" Color="#33000000" />
                <SolidColorBrush x:Key="B.PanelAlto" Color="#2B2426" />
                <SolidColorBrush x:Key="B.Borde" Color="#4D3A3E" />
                <SolidColorBrush x:Key="B.BordeHover" Color="#6E5358" />
                <SolidColorBrush x:Key="B.Hover" Color="#1FFFFFFF" />
                <SolidColorBrush x:Key="B.Coral" Color="#FC8F8F" />
                <SolidColorBrush x:Key="B.SobreAcento" Color="#64242F" />
            </Border.Resources>
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Recursos/coraza.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Coraza" FontSize="17" FontWeight="SemiBold" Foreground="White" Margin="8,0,16,0" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Width="250" Height="30" Background="#33000000" Padding="10,0" HorizontalContentAlignment="Stretch"
                        Command="{Binding AbrirBusquedaCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Buscar canciones, versículos, imágenes y comandos (Ctrl + K)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:Icono Datos="{StaticResource Ico.Buscar}" Width="15" Height="15" Foreground="{DynamicResource B.Lino}" />
                        <TextBlock Grid.Column="1" Text="Buscar canciones, versículos…" Margin="8,0" Foreground="#CCDFD9D8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2" Style="{StaticResource Chip}" Background="#40000000">
                            <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource B.Lino}" />
                        </Border>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ComboBox x:Name="SelectorPantalla" Width="200" MinHeight="30" ItemsSource="{Binding Pantallas}" SelectedItem="{Binding PantallaSeleccionada}"
                              DisplayMemberPath="Descripcion" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,6,0"
                              ToolTip="Pantalla donde se proyecta (Video Beam, televisor…)" />
                    <Button x:Name="BotonProyectar" Style="{StaticResource EstiloProyectar}" Height="30" Command="{Binding AlternarProyeccionCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Iniciar o detener la proyección (F5)">
                        <StackPanel Orientation="Horizontal">
                            <c:Icono Datos="{StaticResource Ico.Monitor}" Width="15" Height="15" />
                            <TextBlock Text="Proyectar" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Border Margin="8,0,0,0" CornerRadius="11" Padding="9,2" VerticalAlignment="Center" ToolTip="{Binding Proyeccion.DescripcionSalida}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#40000000" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Proyeccion.Proyectando}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource B.Coral}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="APAGADO" />
                                    <Setter Property="Foreground" Value="{DynamicResource B.TextoSuave}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Proyeccion.Proyectando}" Value="True">
                                            <Setter Property="Text" Value="● EN VIVO" />
                                            <Setter Property="Foreground" Value="{DynamicResource B.SobreAcento}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Botones de pánico -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <ToggleButton Style="{StaticResource PanicoBarra}" IsChecked="{Binding Proyeccion.Negro}" ToolTip="Pantalla negra con fundido (B)">
                        <StackPanel Orientation="Horizontal">
                            <c:Icono Datos="{StaticResource Ico.MonitorApagado}" Width="14" Height="14" />
                            <TextBlock Text="Negro" Margin="5,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource PanicoBarra}" IsChecked="{Binding Proyeccion.Logo}" ToolTip="Pantalla de logotipo (L)">
                        <StackPanel Orientation="Horizontal">
                            <c:Icono Datos="{StaticResource Ico.Escudo}" Width="14" Height="14" />
                            <TextBlock Text="Logo" Margin="5,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource PanicoBarra}" IsChecked="{Binding Proyeccion.TextoOculto}" ToolTip="Ocultar solo el texto; el fondo sigue (T)">
                        <StackPanel Orientation="Horizontal">
                            <c:Icono Datos="{StaticResource Ico.OjoCerrado}" Width="14" Height="14" />
                            <TextBlock Text="Texto" Margin="5,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Height="30" Background="Transparent" BorderBrush="#55FC8F8F" Foreground="{DynamicResource B.Lino}" Padding="8,4"
                            Command="{Binding LimpiarCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Limpiar todo (Esc). En pantalla completa, Esc sale de ella y Mayús + Esc limpia.">
                        <StackPanel Orientation="Horizontal">
                            <c:Icono Datos="{StaticResource Ico.Cerrar}" Width="14" Height="14" />
                            <TextBlock Text="Limpiar" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BotonApariencia" Style="{StaticResource Boton.Ventana}" Height="46" Command="{Binding AlternarAparienciaCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cambiar la apariencia (Vino Coraza / Oscuro grafito / Claro lino)">
                        <c:Icono Datos="{StaticResource Ico.Luna}" Width="15" Height="15" />
                    </Button>
                    <Button x:Name="BotonConfiguracion" Style="{StaticResource Boton.Ventana}" Height="46" Command="{Binding AbrirConfiguracionCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Configuración">
                        <c:Icono Datos="{StaticResource Ico.Ajustes}" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource Boton.Ventana}" Height="46" Click="Minimizar_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar">
                        <c:Icono Datos="{StaticResource Ico.Minimizar}" Width="13" Height="13" Grosor="1.6" />
                    </Button>
                    <Button Style="{StaticResource Boton.Ventana}" Height="46" Click="Maximizar_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar o restaurar">
                        <c:Icono x:Name="IconoMaximizar" Datos="{StaticResource Ico.Maximizar}" Width="12" Height="12" Grosor="1.6" />
                    </Button>
                    <Button Style="{StaticResource Boton.Cerrar}" Height="46" Click="Cerrar_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cerrar Coraza">
                        <c:Icono Datos="{StaticResource Ico.Cerrar}" Width="13" Height="13" Grosor="1.6" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Aviso de modo Duplicar ================= -->
        <Border Grid.Row="1" Background="#40D9A441" BorderBrush="{DynamicResource B.Advertencia}" BorderThickness="0,0,0,1" Padding="14,6"
                Visibility="{Binding AvisoDuplicar, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cambiar a «Extender»" Style="{StaticResource Boton.Primario}" Command="{Binding CambiarAExtenderCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="Windows está duplicando la pantalla: el público vería la ventana del operador. Cambia a modo «Extender» (equivale a Win + P)." />
            </DockPanel>
        </Border>

        <!-- ================= Contenido ================= -->
        <Grid Grid.Row="2" Margin="8,8,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColIzquierda" Width="300" MinWidth="250" />
                <ColumnDefinition x:Name="ColDivisorIzquierdo" Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="ColDerecha" Width="340" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: bibliotecas -->
            <Border x:Name="PanelIzquierdo" Style="{StaticResource Panel.Tarjeta}" Padding="8">
                <TabControl x:Name="Pestanas" Style="{StaticResource Tabs.Biblioteca}">
                    <TabItem x:Name="TabCanciones">
                        <TabItem.Header>
                            <StackPanel ToolTip="Canciones">
                                <c:Icono Datos="{StaticResource Ico.Musica}" Width="17" Height="17" />
                                <TextBlock Text="Canciones" FontSize="10.5" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <v:PanelCanciones DataContext="{Binding Canciones}" />
                    </TabItem>
                    <TabItem x:Name="TabBiblia">
                        <TabItem.Header>
                            <StackPanel ToolTip="Biblia (Ctrl + B)">
                                <c:Icono Datos="{StaticResource Ico.Biblia}" Width="17" Height="17" />
                                <TextBlock Text="Biblia" FontSize="10.5" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <v:PanelBiblia x:Name="PanelBiblia" DataContext="{Binding Biblia}" />
                    </TabItem>
                    <TabItem x:Name="TabMedios">
                        <TabItem.Header>
                            <StackPanel ToolTip="Imágenes, videos, música y documentos">
                                <c:Icono Datos="{StaticResource Ico.Imagen}" Width="17" Height="17" />
                                <TextBlock Text="Medios" FontSize="10.5" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <v:PanelMedios DataContext="{Binding Medios}" />
                    </TabItem>
                    <TabItem x:Name="TabTextos">
                        <TabItem.Header>
                            <StackPanel ToolTip="Textos y anuncios">
                                <c:Icono Datos="{StaticResource Ico.Texto}" Width="17" Height="17" />
                                <TextBlock Text="Textos" FontSize="10.5" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <v:PanelTextos DataContext="{Binding Textos}" />
                    </TabItem>
                    <TabItem x:Name="TabTemas">
                        <TabItem.Header>
                            <StackPanel ToolTip="Temas de proyección">
                                <c:Icono Datos="{StaticResource Ico.Paleta}" Width="17" Height="17" />
                                <TextBlock Text="Temas" FontSize="10.5" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <v:PanelTemas DataContext="{Binding Temas}" />
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter x:Name="DivisorIzquierdo" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Panel central: orden del servicio y diapositivas -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.42*" MinHeight="140" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="0.58*" MinHeight="180" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Panel.Tarjeta}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:Icono Datos="{StaticResource Ico.Lista}" Width="17" Height="17" Foreground="{DynamicResource B.Coral}" Margin="2,0,4,0" />
                            <TextBox Grid.Column="1" Text="{Binding NombreServicio, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="1"
                                     BorderBrush="Transparent" FontSize="15" FontWeight="SemiBold" Padding="4,2" ToolTip="Nombre del servicio (clic para editar)" />
                            <TextBlock Grid.Column="2" Text="{Binding DuracionTotal}" Style="{StaticResource T.Suave}" VerticalAlignment="Center" Margin="8,0" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button x:Name="BotonCuentaRegresiva" Style="{StaticResource Boton.Icono}" Command="{Binding AgregarCuentaRegresivaCommand}" ToolTip="Agregar una cuenta regresiva (antes del culto)">
                                    <c:Icono Datos="{StaticResource Ico.Reloj}" />
                                </Button>
                                <Button Style="{StaticResource Boton.Icono}" Command="{Binding AgregarEncabezadoCommand}" ToolTip="Agregar encabezado de sección (Bienvenida, Alabanza, Palabra…)">
                                    <c:Icono Datos="{StaticResource Ico.Marcador}" />
                                </Button>
                                <Button Style="{StaticResource Boton.Icono}" Command="{Binding NuevoServicioCommand}" ToolTip="Nuevo servicio">
                                    <c:Icono Datos="{StaticResource Ico.Mas}" />
                                </Button>
                                <Button Style="{StaticResource Boton.Icono}" Command="{Binding AbrirOtroServicioCommand}" ToolTip="Abrir un servicio guardado">
                                    <c:Icono Datos="{StaticResource Ico.Carpeta}" />
                                </Button>
                                <Button Style="{StaticResource Boton.Icono}" Command="{Binding DuplicarServicioCommand}" ToolTip="Duplicar este servicio">
                                    <c:Icono Datos="{StaticResource Ico.Copiar}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <ListBox x:Name="ListaServicio" ItemsSource="{Binding Elementos}" SelectedItem="{Binding ElementoSeleccionado}" AllowDrop="True"
                                     DragOver="ListaServicio_DragOver" Drop="ListaServicio_Drop" MouseDoubleClick="ListaServicio_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ElementoViewModel}">
                                        <Grid>
                                            <Border x:Name="Cabecera" Visibility="Collapsed" CornerRadius="4" Padding="8,3"
                                                    Background="{Binding Color, Converter={StaticResource HexPincel}}">
                                                <TextBlock Text="{Binding Titulo}" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Grid x:Name="Normal">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Coral}" HorizontalAlignment="Left"
                                                         Visibility="{Binding EnVivo, Converter={StaticResource BoolVis}}" ToolTip="En vivo" />
                                                <c:Icono Grid.Column="1" Datos="{Binding Icono}" Width="16" Height="16" Foreground="{DynamicResource B.TextoSuave}" />
                                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TipoTexto}" Style="{StaticResource T.Suave}" FontSize="11" />
                                                </StackPanel>
                                                <c:Icono Grid.Column="3" Datos="{StaticResource Ico.Nota}" Width="14" Height="14" Margin="6,0,0,0"
                                                         Foreground="{DynamicResource B.Advertencia}" ToolTip="{Binding Notas}"
                                                         Visibility="{Binding TieneNotas, Converter={StaticResource BoolVis}}" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,2,0">
                                                    <TextBlock Text="{Binding AvanceTexto}" Foreground="{DynamicResource B.Coral}" FontSize="11" Margin="0,0,6,0"
                                                               ToolTip="Avance automático" />
                                                    <TextBlock Text="{Binding DuracionTexto}" Style="{StaticResource T.Suave}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EsEncabezado}" Value="True">
                                                <Setter TargetName="Cabecera" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Normal" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Subir" Command="{Binding SubirElementoCommand}" />
                                        <MenuItem Header="Bajar" Command="{Binding BajarElementoCommand}" />
                                        <MenuItem Header="Renombrar…" Command="{Binding RenombrarElementoCommand}" />
                                        <MenuItem Header="Tiempo estimado…" Command="{Binding EditarDuracionCommand}" />
                                        <MenuItem Header="Avance automático…" Command="{Binding EditarAvanceCommand}" />
                                        <MenuItem Header="Repetir en bucle" IsCheckable="True" IsChecked="{Binding ElementoSeleccionado.Bucle}" />
                                        <Separator />
                                        <MenuItem Header="Quitar del servicio" Command="{Binding QuitarElementoCommand}" InputGestureText="Supr" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="340"
                                        Visibility="{Binding ServicioVacio, Converter={StaticResource BoolVis}}">
                                <c:Icono Datos="{StaticResource Ico.Lista}" Width="34" Height="34" Foreground="{DynamicResource B.Borde}" />
                                <TextBlock Text="El orden del servicio está vacío" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                <TextBlock Text="Arrastra aquí canciones, pasajes o imágenes, o haz doble clic sobre ellos en la biblioteca."
                                           Style="{StaticResource T.Suave}" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

                <Border Grid.Row="2" Style="{StaticResource Panel.Tarjeta}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding TituloActual}" Style="{StaticResource T.Titulo}" />
                                <TextBlock Text="{Binding SubtituloActual}" Style="{StaticResource T.Suave}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <ComboBox Width="104" Margin="0,0,6,0" ItemsSource="{Binding VersionesBiblia}" SelectedItem="{Binding VersionElegida}"
                                          DisplayMemberPath="Abreviatura" ToolTip="Versión de la Biblia de este pasaje"
                                          Visibility="{Binding EsPasaje, Converter={StaticResource BoolVis}}" />
                                <ComboBox x:Name="SelectorTemaElemento" Width="176" ItemsSource="{Binding OpcionesTema}" SelectedItem="{Binding TemaElegido}" DisplayMemberPath="Nombre"
                                          IsEnabled="{Binding HayElementoActual}" ToolTip="Tema de este elemento" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Boton.Icono}" Command="{Binding EditarActualCommand}" ToolTip="Editar"
                                        Visibility="{Binding ActualEditable, Converter={StaticResource BoolVis}}">
                                    <c:Icono Datos="{StaticResource Ico.Editar}" />
                                </Button>
                                <Button x:Name="BotonAgregarServicio" Command="{Binding AgregarActualAlServicioCommand}" IsEnabled="{Binding HayElementoActual}" Margin="4,0,0,0"
                                        ToolTip="Agregar al orden del servicio">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icono Datos="{StaticResource Ico.Mas}" Width="13" Height="13" />
                                        <TextBlock Text="Servicio" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border DockPanel.Dock="Top" Background="#33D9A441" CornerRadius="6" Padding="10,6" Margin="0,0,0,6"
                                Visibility="{Binding AvisoActual, Converter={StaticResource VacioVis}}">
                            <TextBlock Text="{Binding AvisoActual}" TextWrapping="Wrap" />
                        </Border>
                        <ListBox x:Name="ListaDiapositivas" ItemsSource="{Binding Diapositivas}" SelectedItem="{Binding DiapositivaPrevia}"
                                 ItemContainerStyle="{StaticResource Item.Tarjeta}" MouseDoubleClick="ListaDiapositivas_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiapositivaViewModel}">
                                    <StackPanel Width="192">
                                        <Border x:Name="Marco" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent" Background="Black">
                                            <Viewbox Stretch="Uniform">
                                                <r:LienzoDiapositiva Width="1920" Miniatura="True"
                                                                     Height="{Binding DataContext.Proyeccion.AltoLienzo, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                     Tema="{Binding Tema}" Diapositiva="{Binding Diapositiva}" />
                                            </Viewbox>
                                        </Border>
                                        <Grid Margin="2,4,2,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Numero}" Style="{StaticResource T.Suave}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Etiqueta}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding ColorEtiqueta, Converter={StaticResource HexPincel}}" VerticalAlignment="Center" />
                                            <Border x:Name="Vivo" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource B.Coral}" CornerRadius="3" Padding="5,0">
                                                <TextBlock Text="EN VIVO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource B.Vino}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EsVivo}" Value="True">
                                            <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource B.Coral}" />
                                            <Setter TargetName="Vivo" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Panel derecho: Vista previa y En vivo -->
            <Border Grid.Column="4" Style="{StaticResource Panel.Tarjeta}">
                <!-- En pantallas bajas el panel no cabe entero: se desplaza para llegar a las notas. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,2,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DiapositivaPrevia.Etiqueta}" Style="{StaticResource T.Suave}" FontSize="11" />
                        <TextBlock Text="VISTA PREVIA" Style="{StaticResource T.Seccion}" />
                    </DockPanel>
                    <Border Grid.Row="1" Background="Black" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource B.Borde}" ClipToBounds="True">
                        <Grid>
                            <Viewbox Stretch="Uniform">
                                <r:LienzoDiapositiva Width="1920" Height="{Binding Proyeccion.AltoLienzo}" VistaEstatica="True"
                                                     Tema="{Binding DiapositivaPrevia.Tema}" Diapositiva="{Binding DiapositivaPrevia.Diapositiva}">
                                    <r:LienzoDiapositiva.Style>
                                        <Style TargetType="r:LienzoDiapositiva">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiapositivaPrevia}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </r:LienzoDiapositiva.Style>
                                </r:LienzoDiapositiva>
                            </Viewbox>
                            <!-- Demostración de la transición elegida (se muestra unos segundos sobre la vista previa). -->
                            <Viewbox x:Name="CajaDemoTransicion" Stretch="Uniform" Visibility="Collapsed">
                                <r:SalidaProyeccion x:Name="DemoTransicion" Width="1920" Height="{Binding Proyeccion.AltoLienzo}" Miniatura="True" />
                            </Viewbox>
                            <Border x:Name="EtiquetaDemo" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6" Padding="7,2"
                                    CornerRadius="3" Background="#CC000000" Visibility="Collapsed">
                                <TextBlock x:Name="TextoDemo" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>
                    <Button x:Name="BotonEnviarVivo" Grid.Row="2" Style="{StaticResource Boton.Vivo}" Margin="0,8,0,10" Command="{Binding EnviarAlVivoCommand}"
                            ToolTip="Enviar la vista previa a la proyección (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <c:Icono Datos="{StaticResource Ico.Play}" Relleno="True" Width="14" Height="14" />
                            <TextBlock Text="Enviar al vivo" Margin="8,0,10,0" />
                            <Border Style="{StaticResource Chip}" Background="#33000000">
                                <TextBlock Text="Enter" FontSize="11" FontWeight="Normal" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <DockPanel Grid.Row="3" Margin="2,0,2,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Proyeccion.DescripcionSalida}" Style="{StaticResource T.Suave}" FontSize="11" MaxWidth="200" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Coral}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="EN VIVO" Style="{StaticResource T.Seccion}" Foreground="{DynamicResource B.Coral}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="4" Background="Black" CornerRadius="6" BorderThickness="2" ClipToBounds="True">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#FC8F8F" />
                        </Border.BorderBrush>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Proyeccion.Proyectando}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Pulso">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Opacity)"
                                                                     From="1" To="0.25" Duration="0:0:1.1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulso" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Viewbox Stretch="Uniform">
                            <r:SalidaProyeccion x:Name="SalidaVivo" Width="1920" Height="{Binding Proyeccion.AltoLienzo}" />
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Row="5" Margin="2,8,2,0">
                        <TextBlock Text="{Binding TituloVivo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource T.Suave}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SiguienteTexto, Converter={StaticResource VacioVis}}">
                            <Run Text="Siguiente: " Foreground="{DynamicResource B.Coral}" /><Run Text="{Binding SiguienteTexto, Mode=OneWay}" />
                        </TextBlock>
                        <!-- Controles del video en vivo -->
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding Proyeccion.HayVideo, Converter={StaticResource BoolVis}}">
                            <Button x:Name="BotonVideo" DockPanel.Dock="Left" Style="{StaticResource Boton.Icono}" Padding="5"
                                    Command="{Binding VideoReproducirPausarCommand}" ToolTip="Reproducir o pausar el video">
                                <c:Icono Width="14" Height="14" Relleno="True">
                                    <c:Icono.Style>
                                        <Style TargetType="c:Icono">
                                            <Setter Property="Datos" Value="{StaticResource Ico.Pausa}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Proyeccion.VideoPausado}" Value="True">
                                                    <Setter Property="Datos" Value="{StaticResource Ico.Play}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </c:Icono.Style>
                                </c:Icono>
                            </Button>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Boton.Icono}" Padding="5" Command="{Binding VideoReiniciarCommand}" ToolTip="Volver al inicio">
                                <c:Icono Datos="{StaticResource Ico.Deshacer}" Width="14" Height="14" />
                            </Button>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EstadoVideo}" Style="{StaticResource T.Suave}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Proyeccion.Volumen}" VerticalAlignment="Center" Margin="6,0" ToolTip="Volumen del video" />
                        </DockPanel>
                        <!-- Música de fondo -->
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding Proyeccion.MusicaActual, Converter={StaticResource VacioVis}}">
                            <c:Icono DockPanel.Dock="Left" Datos="{StaticResource Ico.Musica}" Width="14" Height="14" Foreground="{DynamicResource B.Coral}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Boton.Icono}" Padding="5" Command="{Binding MusicaDetenerCommand}" ToolTip="Detener la música">
                                <c:Icono Datos="{StaticResource Ico.Detener}" Width="12" Height="12" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Boton.Icono}" Padding="5" Command="{Binding MusicaAlternarCommand}" ToolTip="Pausar o reanudar la música">
                                <c:Icono Width="13" Height="13" Relleno="True">
                                    <c:Icono.Style>
                                        <Style TargetType="c:Icono">
                                            <Setter Property="Datos" Value="{StaticResource Ico.Play}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Proyeccion.MusicaSonando}" Value="True">
                                                    <Setter Property="Datos" Value="{StaticResource Ico.Pausa}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </c:Icono.Style>
                                </c:Icono>
                            </Button>
                            <Slider DockPanel.Dock="Right" Width="70" Minimum="0" Maximum="1" Value="{Binding Proyeccion.VolumenMusica}" VerticalAlignment="Center"
                                    Margin="4,0" ToolTip="Volumen de la música" />
                            <TextBlock Text="{Binding Proyeccion.MusicaActual}" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                        </DockPanel>
                    </StackPanel>

                    <ItemsControl Grid.Row="6" ItemsSource="{Binding SeccionesVivo}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" MinWidth="36" Padding="8,3" Margin="0,0,4,4" FontWeight="SemiBold"
                                        Command="{Binding DataContext.IrASeccionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="Saltar a esta sección" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="7" Margin="0,8,0,0">
                        <TextBlock Text="SUPERPOSICIONES" Style="{StaticResource T.Seccion}" Margin="2,0,0,4" />
                        <UniformGrid Columns="3">
                            <Button x:Name="BotonMarquesina" Style="{StaticResource EstiloMarquesina}" Margin="0,0,3,0" Command="{Binding EditarMarquesinaCommand}"
                                    ToolTip="Texto que se desplaza en la parte inferior de la proyección">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icono Datos="{StaticResource Ico.Texto}" Width="13" Height="13" />
                                    <TextBlock Text="Marquesina" Margin="5,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BotonUrgente" Margin="3,0" Padding="6,5" Command="{Binding EnviarMensajeUrgenteCommand}"
                                    ToolTip="Mensaje sobre cualquier contenido que desaparece solo (avisos a padres…)">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icono Datos="{StaticResource Ico.Rayo}" Width="13" Height="13" />
                                    <TextBlock Text="Urgente" Margin="5,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BotonReloj" Style="{StaticResource EstiloReloj}" Margin="3,0,0,0" Command="{Binding AlternarRelojCommand}"
                                    ToolTip="Mostrar u ocultar el reloj en la proyección">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icono Datos="{StaticResource Ico.Reloj}" Width="13" Height="13" />
                                    <TextBlock Text="Reloj" Margin="5,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <DockPanel Grid.Row="8" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="NOTAS DEL OPERADOR" Style="{StaticResource T.Seccion}" Margin="2,0,0,4" />
                        <TextBox Text="{Binding ElementoSeleccionado.Notas, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MinHeight="72" MaxHeight="220"
                                 Tag="Notas del elemento elegido (solo las ve el operador)">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementoSeleccionado}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </DockPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= Barra inferior ================= -->
        <Border Grid.Row="3" Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Borde}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Icono Datos="{StaticResource Ico.Rayo}" Width="13" Height="13" Foreground="{DynamicResource B.TextoSuave}" />
                    <TextBlock Text="Transición" Style="{StaticResource T.Suave}" Margin="6,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="SelectorTransicion" Width="190" MinHeight="24" Height="24" FontSize="12" ItemsSource="{Binding Transiciones}"
                              SelectedItem="{Binding TransicionSeleccionada}" DisplayMemberPath="Nombre"
                              SelectionChanged="SelectorTransicion_SelectionChanged"
                              PreviewMouseMove="SelectorTransicion_PreviewMouseMove"
                              ToolTip="Transición al cambiar de diapositiva. Pasa el mouse por la lista para verla en la vista previa antes de elegirla." />
                    <Button x:Name="BotonVerTransicion" Style="{StaticResource Boton.Icono}" Padding="4" Margin="2,0,0,0" Click="RepetirDemoTransicion_Click"
                            ToolTip="Ver otra vez la transición elegida en la vista previa">
                        <c:Icono Datos="{StaticResource Ico.Play}" Width="12" Height="12" Relleno="True" />
                    </Button>
                    <Slider Width="90" Minimum="100" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" Margin="10,0,6,0"
                            Value="{Binding DuracionTransicion}" IsEnabled="{Binding TransicionManual}" ToolTip="Duración de la transición" />
                    <TextBlock Text="{Binding DuracionTransicion, StringFormat={}{0} ms}" Style="{StaticResource T.Suave}" Width="52" VerticalAlignment="Center" />
                    <Button Style="{StaticResource EstiloPatron}" Height="22" FontSize="12" Margin="6,0,0,0" Command="{Binding AlternarPatronPruebaCommand}"
                            ToolTip="Muestra una cuadrícula para verificar que el proyector muestra toda el área">
                        <StackPanel Orientation="Horizontal">
                            <c:Icono Datos="{StaticResource Ico.Rejilla}" Width="12" Height="12" />
                            <TextBlock Text="Patrón de prueba" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Mensaje}" Margin="16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource B.Estado}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource B.Advertencia}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding EstadoGuardado}" Style="{StaticResource T.Suave}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Icono Datos="{StaticResource Ico.Reloj}" Width="13" Height="13" Foreground="{DynamicResource B.TextoSuave}" />
                    <TextBlock Text="{Binding Reloj}" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Búsqueda universal (Ctrl + K) ================= -->
        <Grid Grid.RowSpan="4" Panel.ZIndex="20" Visibility="{Binding Busqueda.Abierta, Converter={StaticResource BoolVis}}">
            <Border Background="{DynamicResource B.Velo}" MouseLeftButtonDown="Velo_MouseLeftButtonDown" />
            <Border Width="640" VerticalAlignment="Top" Margin="0,72,0,0" Background="{DynamicResource B.PanelAlto}" BorderBrush="{DynamicResource B.Borde}"
                    BorderThickness="1" CornerRadius="10" Padding="10" DataContext="{Binding Busqueda}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" />
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBox x:Name="CajaBusqueda" Text="{Binding Consulta, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="34,10,10,10"
                                 Tag="Busca «juan 3 16», «cuán grande», «negro»…" PreviewKeyDown="CajaBusqueda_PreviewKeyDown" />
                        <c:Icono Datos="{StaticResource Ico.Buscar}" Width="16" Height="16" Margin="12,0,0,0" HorizontalAlignment="Left"
                                 Foreground="{DynamicResource B.TextoSuave}" IsHitTestVisible="False" />
                    </Grid>
                    <ListBox x:Name="ListaResultados" ItemsSource="{Binding Resultados}" SelectedItem="{Binding Seleccionado}" MaxHeight="430"
                             Margin="0,8,0,0" PreviewMouseLeftButtonUp="ListaResultados_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ResultadoBusqueda}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:Icono Datos="{Binding Icono}" Width="16" Height="16" Foreground="{DynamicResource B.Coral}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detalle}" Style="{StaticResource T.Suave}" Visibility="{Binding Detalle, Converter={StaticResource VacioVis}}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Grupo}" FontSize="11" Foreground="{DynamicResource B.TextoSuave}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Preparando (primer inicio, importaciones) ================= -->
        <Grid Grid.RowSpan="4" Panel.ZIndex="30" Visibility="{Binding Preparando, Converter={StaticResource BoolVis}}">
            <Border Background="{DynamicResource B.Velo}" />
            <Border Width="420" VerticalAlignment="Center" Background="{DynamicResource B.PanelAlto}" CornerRadius="12" Padding="24,20">
                <StackPanel>
                    <Image Source="/Recursos/coraza.png" Width="54" Height="54" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding TextoPreparando}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" />
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Borde}" Margin="0,14,0,0" ClipToBounds="True">
                        <Border Width="90" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource B.Coral}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Progreso" />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Progreso" Storyboard.TargetProperty="X" From="-90" To="372" Duration="0:0:1.4" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
