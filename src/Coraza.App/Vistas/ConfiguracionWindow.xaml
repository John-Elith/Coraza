<Window x:Class="Coraza.App.Vistas.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Coraza.App.ViewModels"
        Title="Configuración" Width="780" Height="700" MinWidth="640" MinHeight="480" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="Seccion" TargetType="TextBlock" BasedOn="{StaticResource T.Seccion}">
            <Setter Property="Margin" Value="0,18,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource B.Coral}" />
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource T.Suave}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" MinWidth="100" IsCancel="True" Command="{Binding CancelarCommand}" Margin="0,0,8,0" />
            <Button Content="Guardar" MinWidth="120" Style="{StaticResource Boton.Primario}" Command="{Binding GuardarCommand}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Configuración" FontSize="18" FontWeight="SemiBold" />

                <TextBlock Text="APARIENCIA" Style="{StaticResource Seccion}" />
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Paleta de la interfaz" Style="{StaticResource Rotulo}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Paletas}" SelectedItem="{Binding Paleta}" />
                </Grid>
                <TextBlock Style="{StaticResource T.Suave}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
                           Text="«Oscuro grafito» es un modo oscuro neutro y descansado para la vista; «Claro lino» es cómodo en salones con mucha luz. El cambio se ve al instante; también puedes alternar con el botón de la luna en la barra superior." />

                <TextBlock Text="PROYECCIÓN" Style="{StaticResource Seccion}" />
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Proporción de la salida" Style="{StaticResource Rotulo}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Proporciones}" SelectedItem="{Binding Proporcion}" />
                </Grid>
                <CheckBox Content="Ocultar el puntero del mouse en la proyección" IsChecked="{Binding OcultarCursor}" Margin="0,10,0,0" />
                <CheckBox Content="Reducir movimiento: desactiva TODAS las transiciones (para equipos lentos)" IsChecked="{Binding ReducirMovimiento}" Margin="0,8,0,0" />

                <TextBlock Text="PANTALLA DE LOGOTIPO" Style="{StaticResource Seccion}" />
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Elegir imagen…" Command="{Binding ElegirLogoCommand}" Margin="0,0,6,0" />
                    <Button DockPanel.Dock="Left" Content="Usar el escudo de Coraza" Command="{Binding QuitarLogoCommand}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding RutaLogo, TargetNullValue='Escudo de Coraza'}" Style="{StaticResource T.Suave}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Texto bajo el logotipo" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Column="1" Text="{Binding TextoLogo}" Tag="Nombre de la iglesia (opcional)" />
                </Grid>

                <TextBlock Text="TEMA PARA CADA TIPO DE CONTENIDO" Style="{StaticResource Seccion}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Canciones" Style="{StaticResource Rotulo}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding OpcionesTema}" SelectedItem="{Binding TemaCanciones}" DisplayMemberPath="Nombre" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Biblia" Style="{StaticResource Rotulo}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OpcionesTema}" SelectedItem="{Binding TemaBiblia}" DisplayMemberPath="Nombre" Margin="0,2" />
                    <TextBlock Grid.Row="2" Text="Textos y anuncios" Style="{StaticResource Rotulo}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OpcionesTema}" SelectedItem="{Binding TemaTextos}" DisplayMemberPath="Nombre" Margin="0,2" />
                    <TextBlock Grid.Row="3" Text="Imágenes" Style="{StaticResource Rotulo}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding OpcionesTema}" SelectedItem="{Binding TemaImagenes}" DisplayMemberPath="Nombre" Margin="0,2" />
                </Grid>

                <TextBlock Text="BIBLIA Y LICENCIAS" Style="{StaticResource Seccion}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Versión predeterminada" Style="{StaticResource Rotulo}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Biblias}" SelectedItem="{Binding Biblia}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Licencia CCLI de la iglesia" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LicenciaCcli}" Tag="Se muestra en los créditos" Margin="0,4,0,0" />
                </Grid>
                <TextBlock Style="{StaticResource T.Suave}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                           Text="Proyectar letras con derechos de autor normalmente requiere una licencia (CCLI o equivalente). Los créditos se muestran al final de cada canción." />

                <DockPanel Margin="0,18,0,8">
                    <Button DockPanel.Dock="Right" Content="Restablecer" Command="{Binding RestablecerAtajosCommand}" />
                    <TextBlock Text="ATAJOS DE TECLADO" Style="{StaticResource T.Seccion}" Foreground="{DynamicResource B.Coral}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource T.Suave}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8"
                           Text="Haz clic en un cuadro y pulsa la tecla para agregarla (también funcionan los presentadores inalámbricos). «Limpiar» quita los atajos de esa acción." />
                <ItemsControl ItemsSource="{Binding Atajos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AtajoEditable}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Legible, Mode=OneWay}" IsReadOnly="True" Cursor="Hand"
                                         PreviewKeyDown="Atajo_PreviewKeyDown" ToolTip="Pulsa una tecla para agregarla" />
                                <Button Grid.Column="2" Content="Limpiar" Command="{Binding LimpiarCommand}" Margin="6,0,0,0" Padding="8,4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="DATOS, RESPALDOS Y FUENTES" Style="{StaticResource Seccion}" />
                <TextBlock Text="{Binding ModoDatos}" />
                <TextBlock Text="{Binding CarpetaDatos}" Style="{StaticResource T.Suave}" Margin="0,2,0,8" />
                <WrapPanel>
                    <Button Content="Abrir carpeta de datos" Command="{Binding AbrirCarpetaDatosCommand}" Margin="0,0,8,8" />
                    <Button Content="Crear respaldo ahora" Command="{Binding RespaldarAhoraCommand}" Margin="0,0,8,8" />
                    <Button Content="Abrir carpeta de fuentes" Command="{Binding AbrirCarpetaFuentesCommand}" Margin="0,0,8,8" />
                    <Button Content="Recargar fuentes" Command="{Binding RecargarFuentesCommand}" Margin="0,0,8,8" />
                    <Button Content="Abrir el asistente de inicio" Command="{Binding AbrirAsistenteCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Style="{StaticResource T.Suave}" TextWrapping="Wrap" TextTrimming="None"
                           Text="Se guarda un respaldo automático cada día (se conservan los últimos 30). Para usar fuentes nuevas sin permisos de administrador, copia archivos .ttf u .otf en la carpeta de fuentes y pulsa «Recargar fuentes»." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
