<Window x:Class="Coraza.App.Vistas.EditorTextoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Coraza.App.Controles"
        xmlns:vm="clr-namespace:Coraza.App.ViewModels"
        xmlns:r="clr-namespace:Coraza.Rendering;assembly=Coraza.Rendering"
        Title="{Binding TituloVentana}" Width="980" Height="620" MinWidth="760" MinHeight="460" ResizeMode="CanResize">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding GuardarCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="BotonFormato" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="TÍTULO" Style="{StaticResource T.Seccion}" Margin="2,0,0,4" />
                <TextBox x:Name="CajaTitulo" Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Tag="Por ejemplo: Bienvenida" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PLANTILLA" Style="{StaticResource T.Seccion}" Margin="2,0,0,4" />
                        <ComboBox ItemsSource="{Binding Plantillas}" SelectedItem="{Binding Plantilla}" DisplayMemberPath="Nombre" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TEMA" Style="{StaticResource T.Seccion}" Margin="2,0,0,4" />
                        <ComboBox ItemsSource="{Binding OpcionesTema}" SelectedItem="{Binding TemaElegido}" DisplayMemberPath="Nombre" />
                    </StackPanel>
                </Grid>
                <DockPanel Margin="0,12,0,6">
                    <TextBlock Text="CONTENIDO" Style="{StaticResource T.Seccion}" VerticalAlignment="Center" Margin="2,0,12,0" />
                    <WrapPanel>
                        <Button Style="{StaticResource BotonFormato}" Tag="b" Click="Formato_Click" ToolTip="Negrita (**texto**)" FontWeight="Bold" Content="N" />
                        <Button Style="{StaticResource BotonFormato}" Tag="i" Click="Formato_Click" ToolTip="Cursiva (*texto*)" FontStyle="Italic" Content="C" />
                        <Button Style="{StaticResource BotonFormato}" Tag="u" Click="Formato_Click" ToolTip="Subrayado (__texto__)">
                            <TextBlock Text="S" TextDecorations="Underline" />
                        </Button>
                        <Button Style="{StaticResource BotonFormato}" Tag="r" Click="Formato_Click" ToolTip="Resaltar con el color de acento (==texto==)" Content="Resaltar" />
                        <Button Style="{StaticResource BotonFormato}" Tag="lista" Click="Formato_Click" ToolTip="Lista con viñetas (- al inicio de la línea)" Content="• Lista" />
                        <Button Style="{StaticResource BotonFormato}" Tag="c:coral" Click="Formato_Click" ToolTip="Color coral" MinWidth="26">
                            <Ellipse Width="12" Height="12" Fill="#FC8F8F" />
                        </Button>
                        <Button Style="{StaticResource BotonFormato}" Tag="c:dorado" Click="Formato_Click" ToolTip="Color dorado" MinWidth="26">
                            <Ellipse Width="12" Height="12" Fill="#D9A441" />
                        </Button>
                        <Button Style="{StaticResource BotonFormato}" Tag="c:verde" Click="Formato_Click" ToolTip="Color verde" MinWidth="26">
                            <Ellipse Width="12" Height="12" Fill="#4E8F6A" />
                        </Button>
                        <Button Style="{StaticResource BotonFormato}" Tag="c:azul" Click="Formato_Click" ToolTip="Color azul" MinWidth="26">
                            <Ellipse Width="12" Height="12" Fill="#3E6B8A" />
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Style="{StaticResource T.Suave}" TextWrapping="Wrap" TextTrimming="None" Margin="2,6,0,0"
                           Text="Cada párrafo separado por una línea en blanco es una diapositiva. Formato: **negrita**, *cursiva*, __subrayado__, ==resaltado==, {coral}color{/} y «- » para listas." />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource B.Coral}" Margin="2,4,0,0" Visibility="{Binding Error, Converter={StaticResource VacioVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Cancelar" MinWidth="100" IsCancel="True" Command="{Binding CancelarCommand}" Margin="0,0,8,0" />
                    <Button Content="Guardar" MinWidth="120" Style="{StaticResource Boton.Primario}" Command="{Binding GuardarCommand}" />
                </StackPanel>
            </StackPanel>
            <TextBox x:Name="CajaContenido" Text="{Binding Contenido, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontSize="14"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,8" Tag="Escribe el anuncio…" />
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="VISTA PREVIA" Style="{StaticResource T.Seccion}" Margin="2,0,0,6" />
            <ListBox ItemsSource="{Binding Vista}" ItemContainerStyle="{StaticResource Item.Tarjeta}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiapositivaViewModel}">
                        <StackPanel>
                            <Border CornerRadius="4" ClipToBounds="True" Background="Black">
                                <Viewbox Stretch="Uniform">
                                    <r:LienzoDiapositiva Width="1920" Height="1080" Miniatura="True" Tema="{Binding Tema}" Diapositiva="{Binding Diapositiva}" />
                                </Viewbox>
                            </Border>
                            <TextBlock Text="{Binding Etiqueta}" FontSize="12" Margin="2,4,0,1" Style="{StaticResource T.Suave}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
