<Window x:Class="Coraza.App.Vistas.EditorTemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Coraza.App.Controles"
        xmlns:r="clr-namespace:Coraza.Rendering;assembly=Coraza.Rendering"
        Title="{Binding TituloVentana}" Width="1120" Height="720" MinWidth="900" MinHeight="560" ResizeMode="CanResize">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding GuardarCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="Seccion" TargetType="TextBlock" BasedOn="{StaticResource T.Seccion}">
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource B.Coral}" />
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource T.Suave}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Valor" TargetType="TextBlock" BasedOn="{StaticResource T.Suave}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="Fila" TargetType="Grid">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <CheckBox DockPanel.Dock="Right" Content="Ver con un versículo" IsChecked="{Binding MuestraBiblia}" />
                <TextBlock Text="VISTA PREVIA EN TIEMPO REAL" Style="{StaticResource T.Seccion}" VerticalAlignment="Center" />
            </DockPanel>
            <Border DockPanel.Dock="Bottom" Background="#33D9A441" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                    Visibility="{Binding AvisoLegibilidad, Converter={StaticResource VacioVis}}">
                <TextBlock Text="{Binding AvisoLegibilidad}" TextWrapping="Wrap" />
            </Border>
            <Border Background="Black" CornerRadius="6" BorderBrush="{DynamicResource B.Borde}" BorderThickness="1" VerticalAlignment="Top" ClipToBounds="True">
                <Viewbox Stretch="Uniform">
                    <r:LienzoDiapositiva Width="1920" Height="1080" Tema="{Binding TemaVista}" Diapositiva="{Binding Muestra}" />
                </Viewbox>
            </Border>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar" MinWidth="100" IsCancel="True" Command="{Binding CancelarCommand}" Margin="0,0,8,0" />
                <Button Content="Guardar tema" MinWidth="130" Style="{StaticResource Boton.Primario}" Command="{Binding GuardarCommand}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="NOMBRE" Style="{StaticResource T.Seccion}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" FontSize="14" />

                    <!-- Fondo -->
                    <TextBlock Text="FONDO" Style="{StaticResource Seccion}" />
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tipo" Style="{StaticResource Rotulo}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TiposFondo}" SelectedValuePath="Valor" DisplayMemberPath="Nombre" SelectedValue="{Binding TipoFondo}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color" Style="{StaticResource Rotulo}" />
                        <c:SelectorColor Grid.Column="1" Color="{Binding Color1}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}" Visibility="{Binding EsDegradado, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Segundo color" Style="{StaticResource Rotulo}" />
                        <c:SelectorColor Grid.Column="1" Color="{Binding Color2}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}" Visibility="{Binding EsDegradado, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ángulo" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="360" TickFrequency="15" IsSnapToTickEnabled="True" Value="{Binding Angulo}" />
                        <TextBlock Grid.Column="2" Text="{Binding Angulo, StringFormat={}{0:0}°}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}" Visibility="{Binding EsImagen, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Imagen" Style="{StaticResource Rotulo}" />
                        <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Left" Content="Elegir…" Command="{Binding ElegirImagenCommand}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding RutaImagen}" Style="{StaticResource T.Suave}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Grid>
                    <Grid Style="{StaticResource Fila}" Visibility="{Binding EsImagen, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Desenfoque" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Desenfoque}" />
                        <TextBlock Grid.Column="2" Text="{Binding Desenfoque, StringFormat={}{0:0.0}}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Oscurecer" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Oscurecer}" />
                        <TextBlock Grid.Column="2" Text="{Binding Oscurecer, StringFormat={}{0:P0}}" Style="{StaticResource Valor}" />
                    </Grid>

                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Movimiento" Style="{StaticResource Rotulo}" ToolTip="Fondo animado que continúa sin reiniciarse entre diapositivas" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Animaciones}" SelectedValuePath="Valor" DisplayMemberPath="Nombre" SelectedValue="{Binding Animacion}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}" Visibility="{Binding TieneAnimacion, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Velocidad" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0.25" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Velocidad}" />
                        <TextBlock Grid.Column="2" Text="{Binding Velocidad, StringFormat={}{0:0.00}×}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}" Visibility="{Binding TieneAnimacion, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Intensidad" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Intensidad}" />
                        <TextBlock Grid.Column="2" Text="{Binding Intensidad, StringFormat={}{0:P0}}" Style="{StaticResource Valor}" />
                    </Grid>

                    <!-- Texto -->
                    <TextBlock Text="TEXTO" Style="{StaticResource Seccion}" />
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fuente" Style="{StaticResource Rotulo}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Fuentes}" SelectedItem="{Binding Fuente}" MaxDropDownHeight="360" IsTextSearchEnabled="True">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tamaño" Style="{StaticResource Rotulo}" ToolTip="Porcentaje de la altura de la pantalla" />
                        <Slider Grid.Column="1" Minimum="2" Maximum="20" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding TamanoPct}" />
                        <TextBlock Grid.Column="2" Text="{Binding TamanoPct, StringFormat={}{0:0.#} %}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Grosor" Style="{StaticResource Rotulo}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Pesos}" SelectedValuePath="Valor" DisplayMemberPath="Nombre" SelectedValue="{Binding Peso}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color" Style="{StaticResource Rotulo}" />
                        <c:SelectorColor Grid.Column="1" Color="{Binding ColorTexto}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Interlineado" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0.8" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Interlineado}" />
                        <TextBlock Grid.Column="2" Text="{Binding Interlineado, StringFormat={}{0:0.00}}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Alineación" Style="{StaticResource Rotulo}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AlineacionesH}" SelectedValuePath="Valor" DisplayMemberPath="Nombre" SelectedValue="{Binding AlineacionH}" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding AlineacionesV}" SelectedValuePath="Valor" DisplayMemberPath="Nombre" SelectedValue="{Binding AlineacionV}" />
                    </Grid>
                    <WrapPanel Margin="110,6,0,0">
                        <CheckBox Content="Cursiva" IsChecked="{Binding Cursiva}" Margin="0,0,14,6" />
                        <CheckBox Content="Mayúsculas" IsChecked="{Binding Mayusculas}" Margin="0,0,14,6" />
                        <CheckBox Content="Ajuste automático" IsChecked="{Binding AjusteAutomatico}" Margin="0,0,0,6"
                                  ToolTip="Reduce la letra para que el texto quepa en la pantalla" />
                    </WrapPanel>

                    <!-- Sombra y caja -->
                    <TextBlock Text="SOMBRA Y CAJA DE FONDO" Style="{StaticResource Seccion}" />
                    <CheckBox Content="Sombra detrás del texto" IsChecked="{Binding SombraActiva}" Margin="0,2,0,4" />
                    <Grid Style="{StaticResource Fila}" IsEnabled="{Binding SombraActiva}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Intensidad" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding SombraOpacidad}" />
                        <TextBlock Grid.Column="2" Text="{Binding SombraOpacidad, StringFormat={}{0:P0}}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}" IsEnabled="{Binding SombraActiva}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Difuminado" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding SombraDesenfoque}" />
                        <TextBlock Grid.Column="2" Text="{Binding SombraDesenfoque, StringFormat={}{0:0.0}}" Style="{StaticResource Valor}" />
                    </Grid>
                    <CheckBox Content="Caja detrás del texto" IsChecked="{Binding CajaActiva}" Margin="0,8,0,4" />
                    <Grid Style="{StaticResource Fila}" IsEnabled="{Binding CajaActiva}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color de la caja" Style="{StaticResource Rotulo}" />
                        <c:SelectorColor Grid.Column="1" Color="{Binding ColorCaja}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}" IsEnabled="{Binding CajaActiva}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opacidad" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding OpacidadCaja}" />
                        <TextBlock Grid.Column="2" Text="{Binding OpacidadCaja, StringFormat={}{0:P0}}" Style="{StaticResource Valor}" />
                    </Grid>

                    <!-- Pie -->
                    <TextBlock Text="REFERENCIA Y CRÉDITOS (PIE)" Style="{StaticResource Seccion}" />
                    <CheckBox Content="Mostrar la referencia bíblica y los créditos" IsChecked="{Binding MostrarPie}" Margin="0,2,0,4" />
                    <Grid Style="{StaticResource Fila}" IsEnabled="{Binding MostrarPie}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color" Style="{StaticResource Rotulo}" />
                        <c:SelectorColor Grid.Column="1" Color="{Binding ColorPie}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}" IsEnabled="{Binding MostrarPie}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tamaño" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding TamanoPiePct}" />
                        <TextBlock Grid.Column="2" Text="{Binding TamanoPiePct, StringFormat={}{0:0.#} %}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}" IsEnabled="{Binding MostrarPie}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Posición" Style="{StaticResource Rotulo}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding PosicionesPie}" SelectedValuePath="Valor" DisplayMemberPath="Nombre" SelectedValue="{Binding PosicionPie}" />
                    </Grid>

                    <!-- Diseño -->
                    <TextBlock Text="DISEÑO Y DIVISIÓN" Style="{StaticResource Seccion}" />
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Margen seguro" Style="{StaticResource Rotulo}" ToolTip="Para proyectores que recortan los bordes" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="15" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding MargenPct}" />
                        <TextBlock Grid.Column="2" Text="{Binding MargenPct, StringFormat={}{0:0.#} %}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Líneas máximas" Style="{StaticResource Rotulo}" ToolTip="Líneas de canción por diapositiva" />
                        <Slider Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LineasMaximas}" />
                        <TextBlock Grid.Column="2" Text="{Binding LineasMaximas}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Caracteres" Style="{StaticResource Rotulo}" ToolTip="Máximo de caracteres por diapositiva en pasajes largos" />
                        <Slider Grid.Column="1" Minimum="80" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding CaracteresMaximos}" />
                        <TextBlock Grid.Column="2" Text="{Binding CaracteresMaximos}" Style="{StaticResource Valor}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Versículos" Style="{StaticResource Rotulo}" ToolTip="Versículos por diapositiva" />
                        <Slider Grid.Column="1" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding VersiculosPorDiapositiva}" />
                        <TextBlock Grid.Column="2" Text="{Binding VersiculosPorDiapositiva}" Style="{StaticResource Valor}" />
                    </Grid>
                    <CheckBox Content="Número de versículo en superíndice" IsChecked="{Binding NumerosVersiculo}" Margin="110,6,0,0" />

                    <!-- Transición -->
                    <TextBlock Text="TRANSICIÓN" Style="{StaticResource Seccion}" />
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Efecto" Style="{StaticResource Rotulo}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Transiciones}" SelectedValuePath="Valor" DisplayMemberPath="Nombre" SelectedValue="{Binding Transicion}" />
                    </Grid>
                    <Grid Style="{StaticResource Fila}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Duración" Style="{StaticResource Rotulo}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding DuracionMs}" />
                        <TextBlock Grid.Column="2" Text="{Binding DuracionMs, StringFormat={}{0} ms}" Style="{StaticResource Valor}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
