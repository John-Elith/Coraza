<Window x:Class="Coraza.App.Vistas.AsistenteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Coraza.App.Controles"
        xmlns:m="clr-namespace:Coraza.Core.Modelos;assembly=Coraza.Core"
        xmlns:r="clr-namespace:Coraza.Rendering;assembly=Coraza.Rendering"
        Title="Bienvenido a Coraza" Width="800" Height="600" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="TituloPaso" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Explicacion" TargetType="TextBlock" BasedOn="{StaticResource T.Suave}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource T.Seccion}">
            <Setter Property="Margin" Value="2,12,0,6" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource B.Barra}" Padding="24,16">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/Recursos/coraza.png" Width="44" Height="44" Margin="0,0,14,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding PasoTexto}" Foreground="#DDFFFFFF" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Bienvenido a Coraza" FontSize="21" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Configuremos lo esencial en cuatro pasos. Todo se puede cambiar después en Configuración." Foreground="#DDFFFFFF" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource B.Borde}" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Omitir" Style="{StaticResource Boton.Fantasma}" Command="{Binding OmitirCommand}" MinWidth="90" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Atrás" MinWidth="90" Margin="0,0,8,0" Command="{Binding AtrasCommand}"
                            Visibility="{Binding EsPrimero, Converter={StaticResource BoolVis}, ConverterParameter=invertir}" />
                    <Button x:Name="BotonSiguiente" Content="{Binding TextoSiguiente}" Style="{StaticResource Boton.Primario}" MinWidth="170" Command="{Binding SiguienteCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="30,22">
            <!-- Paso 1: la iglesia -->
            <StackPanel Visibility="{Binding Paso, Converter={StaticResource IgualVis}, ConverterParameter=0}">
                <TextBlock Text="1. Tu iglesia" Style="{StaticResource TituloPaso}" />
                <TextBlock Style="{StaticResource Explicacion}"
                           Text="Coraza funciona completamente sin internet. El nombre de la iglesia aparece bajo el escudo en la pantalla de logotipo (tecla L)." />
                <TextBlock Text="NOMBRE DE LA IGLESIA" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding NombreIglesia, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Tag="Por ejemplo: Iglesia Cristiana Emanuel (opcional)" />
                <TextBlock Text="IDIOMA DE LA INTERFAZ" Style="{StaticResource Rotulo}" />
                <ComboBox Width="240" HorizontalAlignment="Left" SelectedIndex="0" IsEnabled="False">
                    <ComboBoxItem Content="Español" />
                </ComboBox>
                <TextBlock Style="{StaticResource T.Suave}" Margin="2,6,0,0" Text="Inglés y portugués llegarán en una próxima versión." />
            </StackPanel>

            <!-- Paso 2: pantallas -->
            <StackPanel Visibility="{Binding Paso, Converter={StaticResource IgualVis}, ConverterParameter=1}">
                <TextBlock Text="2. Pantallas y Video Beam" Style="{StaticResource TituloPaso}" />
                <TextBlock Style="{StaticResource Explicacion}"
                           Text="Conecta el Video Beam por HDMI o VGA. Coraza muestra los controles en tu monitor y la proyección limpia en la segunda pantalla." />
                <Border Style="{StaticResource Panel.Tarjeta}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding EstadoPantallas}" TextWrapping="Wrap" FontSize="14" />
                        <ItemsControl ItemsSource="{Binding Pantallas}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <c:Icono Datos="{StaticResource Ico.Monitor}" Width="14" Height="14" Foreground="{DynamicResource B.Coral}" />
                                        <TextBlock Text="{Binding}" Margin="8,0,0,0" Style="{StaticResource T.Suave}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <WrapPanel Margin="0,14,0,0">
                    <Button Content="Volver a detectar" Command="{Binding ActualizarPantallasCommand}" Margin="0,0,8,8" />
                    <Button Content="Cambiar a «Extender»" Style="{StaticResource Boton.Primario}" Command="{Binding CambiarAExtenderCommand}" Margin="0,0,8,8"
                            Visibility="{Binding Duplicando, Converter={StaticResource BoolVis}}" />
                    <Button Content="Mostrar u ocultar el patrón de prueba" Command="{Binding ProbarPantallaCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Style="{StaticResource T.Suave}" TextWrapping="Wrap" TextTrimming="None"
                           Text="El patrón de prueba muestra una cuadrícula y tamaños de letra para verificar que el proyector muestra toda el área y que se lee desde el fondo del salón." />
            </StackPanel>

            <!-- Paso 3: apariencia y tema -->
            <DockPanel Visibility="{Binding Paso, Converter={StaticResource IgualVis}, ConverterParameter=2}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="3. Apariencia y tema" Style="{StaticResource TituloPaso}" />
                    <TextBlock Style="{StaticResource Explicacion}" Margin="0,0,0,6"
                               Text="Elige cómo se ve la ventana del operador y el tema con el que se proyectarán las canciones." />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Paleta de la interfaz" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Width="220" ItemsSource="{Binding Paletas}" SelectedItem="{Binding Paleta}" />
                    </StackPanel>
                    <TextBlock Text="TEMA PARA LAS CANCIONES" Style="{StaticResource Rotulo}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Temas}" SelectedItem="{Binding TemaCanciones}" ItemContainerStyle="{StaticResource Item.Tarjeta}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Tema}">
                            <StackPanel Width="210">
                                <Border CornerRadius="4" ClipToBounds="True" Background="Black">
                                    <Viewbox Stretch="Uniform">
                                        <r:LienzoDiapositiva Width="1920" Height="1080" Miniatura="True" Tema="{Binding}"
                                                             Diapositiva="{Binding DataContext.Muestra, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" Margin="2,5,0,1" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Paso 4: Biblia y licencia -->
            <StackPanel Visibility="{Binding Paso, Converter={StaticResource IgualVis}, ConverterParameter=3}">
                <TextBlock Text="4. Biblia y licencia" Style="{StaticResource TituloPaso}" />
                <TextBlock Style="{StaticResource Explicacion}"
                           Text="Coraza incluye dos versiones: la Versión Biblia Libre (español actual) y la Reina-Valera 1909, que conserva la ortografía de su época («crió», «fué», «á»). Si tu iglesia tiene licencia de otra versión (RVR1960, NVI…), impórtala desde un archivo de e-Sword, MySword, MyBible, Zefania, OSIS o USFM." />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Versión predeterminada" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox Width="280" ItemsSource="{Binding Biblias}" SelectedItem="{Binding Biblia}" />
                    <Button Content="Importar otra versión…" Command="{Binding ImportarBibliaCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="LICENCIA CCLI DE LA IGLESIA (OPCIONAL)" Style="{StaticResource Rotulo}" />
                <TextBox Width="280" HorizontalAlignment="Left" Text="{Binding LicenciaCcli}" Tag="Se muestra en los créditos de las canciones" />
                <Border Style="{StaticResource Panel.Tarjeta}" Margin="0,22,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Atajos para empezar" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource T.Suave}" TextWrapping="Wrap" TextTrimming="None" LineHeight="20"
                                   Text="Ctrl + B: Biblia (escribe «jn 3 16» y pulsa Enter dos veces) · Ctrl + K: buscar cualquier cosa · Enter: enviar al vivo · → o Espacio: siguiente · B: pantalla negra · L: logotipo · F5: proyectar · Esc: salir de la pantalla completa." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
